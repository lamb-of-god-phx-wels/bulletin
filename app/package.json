{
  "name": "@cbb/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/services",
    "packages/workers",
    "packages/shell",
    "packages/ui"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "dev": "vite --config packages/ui/vite.config.ts --host 127.0.0.1 --port 5173",
    "demo": "npm run dev",
    "build:ui": "vite build --config packages/ui/vite.config.ts",
    "build:shell": "npm run build -w @cbb/shell",
    "build": "npm run typecheck && npm run build:ui && npm run build:shell",
    "start": "npm run build && electron packages/shell/dist/main.js",
    "preview": "vite preview --config packages/ui/vite.config.ts --host 127.0.0.1 --port 4173",
    "verify:m3-quarantine:linux": "native/quarantine-worker/scripts/verify.sh",
    "test:m3-native:linux": "npm run verify:m3-quarantine:linux && CBB_RUN_NATIVE_M3=1 vitest run test/m3-native-build.test.ts packages/workers/src/quarantine/nodeBubblewrapWorker.native.test.ts packages/workers/src/quarantine/nodePdfFlattenWorker.native.test.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.12.1",
    "electron": "^43.1.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
