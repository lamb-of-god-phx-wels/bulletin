{
  "name": "@cbb/shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/main.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b && esbuild src/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/preload.cjs",
    "start": "electron ./dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cbb/core": "*",
    "@cbb/services": "*",
    "@cbb/workers": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "electron": "^43.1.0"
  }
}
