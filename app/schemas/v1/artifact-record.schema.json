{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://church-bulletin-builder.local/schema/v1/artifact-record.schema.json",
  "title": "CBB Immutable Build Artifact Record",
  "description": "Closed build lifecycle and immutable evidence record. Non-success records can never claim output files; successful compile/compose/revalidate records carry mode-specific evidence.",
  "type": "object",
  "required": [
    "version",
    "kind",
    "buildId",
    "bulletinLocalId",
    "artifactKind",
    "status",
    "executionMode",
    "createdAt",
    "outputForm",
    "readinessProfile",
    "canonicalRevisionToken",
    "renderInputHash",
    "toolIdentities",
    "schemaIdentities",
    "diagnosticCodes"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "kind": { "const": "artifactRecord" },
    "buildId": { "$ref": "#/$defs/uuidV4" },
    "bulletinLocalId": { "$ref": "#/$defs/uuidV4" },
    "artifactKind": {
      "enum": ["preview", "draft", "finalCandidate", "importedDiagnostic"]
    },
    "status": {
      "enum": ["queued", "running", "succeeded", "failed", "canceled", "timedOut"]
    },
    "executionMode": { "enum": ["compile", "compose", "revalidate"] },
    "createdAt": { "$ref": "#/$defs/utcTimestamp" },
    "startedAt": { "$ref": "#/$defs/utcTimestamp" },
    "completedAt": { "$ref": "#/$defs/utcTimestamp" },
    "outputForm": { "enum": ["readerOrder", "bookletTwoUp"] },
    "readinessProfile": { "enum": ["draft", "printFinal", "accessibleFinal"] },
    "canonicalRevisionToken": { "$ref": "#/$defs/sha256" },
    "renderInputHash": { "$ref": "#/$defs/sha256" },
    "readinessInputHash": { "$ref": "#/$defs/sha256" },
    "editGeneration": { "type": "integer", "minimum": 0 },
    "requestSequence": { "type": "integer", "minimum": 1 },
    "watermark": { "$ref": "#/$defs/watermark" },
    "toolIdentities": {
      "type": "array",
      "items": { "$ref": "#/$defs/toolIdentity" },
      "maxItems": 32
    },
    "schemaIdentities": {
      "type": "array",
      "items": { "$ref": "#/$defs/schemaIdentity" },
      "maxItems": 32
    },
    "diagnosticCodes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CBB-[A-Z]+-[0-9]{4}$" },
      "maxItems": 1000
    },
    "boundedLogRef": { "$ref": "#/$defs/artifactLogRelativePath" },
    "outputEvidence": {
      "oneOf": [
        { "$ref": "#/$defs/compileEvidence" },
        { "$ref": "#/$defs/composeEvidence" },
        { "$ref": "#/$defs/revalidateEvidence" }
      ]
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "status": { "const": "queued" },
            "startedAt": false,
            "completedAt": false,
            "outputEvidence": false
          }
        },
        {
          "properties": {
            "status": { "const": "running" },
            "startedAt": true,
            "completedAt": false,
            "outputEvidence": false
          },
          "required": ["startedAt"]
        },
        {
          "properties": {
            "status": { "enum": ["failed", "canceled", "timedOut"] },
            "completedAt": true,
            "outputEvidence": false
          },
          "required": ["completedAt"]
        },
        {
          "properties": {
            "status": { "const": "succeeded" },
            "startedAt": true,
            "completedAt": true,
            "outputEvidence": true
          },
          "required": ["startedAt", "completedAt", "outputEvidence"]
        }
      ]
    },
    {
      "if": { "properties": { "artifactKind": { "const": "preview" } } },
      "then": {
        "properties": { "editGeneration": true, "requestSequence": true },
        "required": ["editGeneration", "requestSequence"]
      }
    },
    {
      "if": { "properties": { "artifactKind": { "const": "draft" } } },
      "then": {
        "properties": { "watermark": true, "readinessInputHash": true },
        "required": ["watermark", "readinessInputHash"]
      }
    },
    {
      "if": { "properties": { "artifactKind": { "const": "finalCandidate" } } },
      "then": {
        "required": ["readinessInputHash"],
        "properties": {
          "readinessInputHash": true,
          "readinessProfile": { "enum": ["printFinal", "accessibleFinal"] },
          "watermark": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "succeeded" },
          "executionMode": { "const": "compile" }
        },
        "required": ["status", "executionMode"]
      },
      "then": {
        "properties": {
          "outputForm": { "const": "readerOrder" },
          "outputEvidence": { "$ref": "#/$defs/compileEvidence" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "succeeded" },
          "executionMode": { "const": "compose" }
        },
        "required": ["status", "executionMode"]
      },
      "then": {
        "properties": {
          "outputForm": { "const": "bookletTwoUp" },
          "outputEvidence": { "$ref": "#/$defs/composeEvidence" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "succeeded" },
          "executionMode": { "const": "revalidate" }
        },
        "required": ["status", "executionMode"]
      },
      "then": {
        "properties": {
          "outputEvidence": { "$ref": "#/$defs/revalidateEvidence" }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "artifactTypstRelativePath": {
      "type": "string",
      "pattern": "^artifacts/[0-9a-f-]{36}/[0-9a-f-]{36}\\.typ$"
    },
    "artifactPdfRelativePath": {
      "type": "string",
      "pattern": "^artifacts/[0-9a-f-]{36}/[0-9a-f-]{36}\\.pdf$"
    },
    "artifactLogRelativePath": {
      "type": "string",
      "pattern": "^artifacts/[0-9a-f-]{36}/[0-9a-f-]{36}\\.log$"
    },
    "toolIdentity": {
      "type": "object",
      "required": ["toolId", "version", "hash"],
      "properties": {
        "toolId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "schemaIdentity": {
      "type": "object",
      "required": ["schemaId", "version", "hash"],
      "properties": {
        "schemaId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "version": { "type": "integer", "minimum": 1 },
        "hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "watermark": {
      "type": "object",
      "required": ["kind", "text", "version"],
      "properties": {
        "kind": { "enum": ["draft", "proof"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "verifiedAsset": {
      "type": "object",
      "required": ["assetRef", "binaryHash", "byteSize", "mediaType"],
      "properties": {
        "assetRef": {
          "type": "string",
          "pattern": "^asset:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "binaryHash": { "$ref": "#/$defs/sha256" },
        "byteSize": { "type": "integer", "minimum": 0, "maximum": 536870912 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "additionalProperties": false
    },
    "verifiedFontFace": {
      "type": "object",
      "required": ["fontRef", "familyDigest", "faceId", "faceHash", "byteSize", "embeddingPermitted", "subsettingPermitted"],
      "properties": {
        "fontRef": {
          "type": "string",
          "pattern": "^font:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "familyDigest": { "$ref": "#/$defs/sha256" },
        "faceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
        "faceHash": { "$ref": "#/$defs/sha256" },
        "byteSize": { "type": "integer", "minimum": 0, "maximum": 52428800 },
        "embeddingPermitted": { "type": "boolean" },
        "subsettingPermitted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "resourceClosure": {
      "type": "object",
      "required": ["assets", "fontFaces"],
      "properties": {
        "assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/verifiedAsset" },
          "maxItems": 5000
        },
        "fontFaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/verifiedFontFace" },
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "pdfEvidence": {
      "type": "object",
      "required": ["relativePath", "hash", "byteSize", "pageCount", "pdfVersion"],
      "properties": {
        "relativePath": { "$ref": "#/$defs/artifactPdfRelativePath" },
        "hash": { "$ref": "#/$defs/sha256" },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "pageCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "pdfVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "standards": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "maxItems": 16
        },
        "validationReportHash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "compileEvidence": {
      "type": "object",
      "required": ["mode", "renderProjectionHash", "typstRelativePath", "typstHash", "generatorVersion", "pdf", "resources"],
      "properties": {
        "mode": { "const": "compile" },
        "renderProjectionHash": { "$ref": "#/$defs/sha256" },
        "typstRelativePath": { "$ref": "#/$defs/artifactTypstRelativePath" },
        "typstHash": { "$ref": "#/$defs/sha256" },
        "generatorVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "navigationMap": { "$ref": "#/$defs/pdfNavigationMap" },
        "pdf": { "$ref": "#/$defs/pdfEvidence" },
        "resources": { "$ref": "#/$defs/resourceClosure" }
      },
      "additionalProperties": false
    },
    "pdfNavigationEntry": {
      "type": "object",
      "required": ["resolvedId", "sourceElementId", "pageNumber", "region"],
      "properties": {
        "resolvedId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sourceElementId": { "$ref": "https://church-bulletin-builder.local/schema/v1/common.schema.json#/$defs/nodeId" },
        "pageNumber": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "region": { "enum": ["body", "page-background", "page-foreground"] }
      },
      "additionalProperties": false
    },
    "pdfNavigationMap": {
      "type": "object",
      "required": ["version", "entries"],
      "properties": {
        "version": { "type": "integer", "const": 1 },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/pdfNavigationEntry" },
          "maxItems": 50000
        }
      },
      "additionalProperties": false
    },
    "composeEvidence": {
      "type": "object",
      "required": ["mode", "parentReaderBuildId", "parentReaderPdfHash", "parentRenderInputHash", "logicalPageCount", "imposedSideCount", "compositor", "pdf", "resources"],
      "properties": {
        "mode": { "const": "compose" },
        "parentReaderBuildId": { "$ref": "#/$defs/uuidV4" },
        "parentReaderPdfHash": { "$ref": "#/$defs/sha256" },
        "parentRenderInputHash": { "$ref": "#/$defs/sha256" },
        "logicalPageCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "imposedSideCount": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "compositor": { "$ref": "#/$defs/toolIdentity" },
        "pdf": { "$ref": "#/$defs/pdfEvidence" },
        "resources": { "$ref": "#/$defs/resourceClosure" }
      },
      "additionalProperties": false
    },
    "revalidateEvidence": {
      "type": "object",
      "required": ["mode", "sourceRenderBuildId", "sourcePdfHash", "sourceRenderInputHash", "pdf", "resources"],
      "properties": {
        "mode": { "const": "revalidate" },
        "sourceRenderBuildId": { "$ref": "#/$defs/uuidV4" },
        "sourcePdfHash": { "$ref": "#/$defs/sha256" },
        "sourceRenderInputHash": { "$ref": "#/$defs/sha256" },
        "sourceTypstHash": { "$ref": "#/$defs/sha256" },
        "pdf": { "$ref": "#/$defs/pdfEvidence" },
        "resources": { "$ref": "#/$defs/resourceClosure" }
      },
      "additionalProperties": false
    }
  }
}
