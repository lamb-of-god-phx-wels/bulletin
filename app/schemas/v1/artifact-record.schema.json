{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://church-bulletin-builder.local/schema/v1/artifact-record.schema.json",
  "title": "CBB Artifact Record",
  "description": "Build records, generated Typst/PDF records, Scripture normalizer/presentation and generated-rights evidence, diagnostics references, stale state, and approval references.",
  "type": "object",
  "required": ["version", "kind", "buildId", "bulletinLocalId", "builtAt", "documentHash", "generatorVersion"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "kind": { "const": "artifactRecord" },
    "buildId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "bulletinLocalId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "builtAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "documentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generatorVersion": { "type": "string", "minLength": 1 },
    "typstVersion": { "type": "string" },
    "pdfHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pageCount": { "type": "integer", "minimum": 0 },
    "stale": { "type": "boolean" },
    "approvedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "diagnosticsRef": { "type": "string" },
    "selectedFaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["portableFontId", "faceId", "faceHash"],
        "properties": {
          "portableFontId": {
            "type": "string",
            "pattern": "^font:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "faceId": { "type": "string", "minLength": 1 },
          "faceHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
