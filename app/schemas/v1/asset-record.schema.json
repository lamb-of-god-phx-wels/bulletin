{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://church-bulletin-builder.local/schema/v1/asset-record.schema.json",
  "title": "CBB Asset Record",
  "description": "Workspace-local metadata for one immutable, canonical, build-safe asset revision. Storage paths are derived from localId and never supplied by portable content.",
  "type": "object",
  "required": [
    "version",
    "kind",
    "localId",
    "portableAssetId",
    "displayName",
    "mediaType",
    "canonicalHash",
    "byteSize",
    "sanitizationState",
    "aiVisibility",
    "importedAt"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "kind": { "const": "assetRecord" },
    "localId": { "$ref": "#/$defs/localResourceId" },
    "portableAssetId": { "$ref": "#/$defs/portableAssetRef" },
    "displayName": { "$ref": "#/$defs/boundedText" },
    "originalFilename": { "$ref": "#/$defs/boundedText" },
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+/-]*$",
      "description": "MIME type of the immutable canonical build-safe bytes."
    },
    "canonicalHash": { "$ref": "#/$defs/sha256" },
    "byteSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 524288000,
      "description": "Exact canonical byte count; the maximum is the one-asset hard cap."
    },
    "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
    "height": { "type": "integer", "minimum": 1, "maximum": 32768 },
    "sanitizationState": {
      "enum": ["pending", "validated", "failed"],
      "description": "Only validated revisions may enter a render/build closure."
    },
    "sanitizer": {
      "type": "object",
      "required": ["toolId", "version", "toolHash"],
      "properties": {
        "toolId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "toolHash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "sourceOriginal": {
      "type": "object",
      "required": ["hash", "byteSize"],
      "properties": {
        "hash": { "$ref": "#/$defs/sha256" },
        "byteSize": { "type": "integer", "minimum": 1, "maximum": 524288000 }
      },
      "additionalProperties": false,
      "description": "Optional inert provenance for an original upload; no storage path is persisted."
    },
    "aiVisibility": {
      "enum": ["private", "approved", "public"],
      "default": "private"
    },
    "importedAt": { "$ref": "#/$defs/utcTimestamp" }
  },
  "additionalProperties": false,
  "$defs": {
    "localResourceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "portableAssetRef": {
      "type": "string",
      "pattern": "^asset:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]+$"
    }
  }
}
