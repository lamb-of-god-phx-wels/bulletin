{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://church-bulletin-builder.local/schema/v1/font-record.schema.json",
  "title": "CBB Font Record",
  "description": "Workspace-local managed font family/face metadata, immutable hashes, validation, licensing, and portability state.",
  "type": "object",
  "required": ["version", "kind", "localId", "portableFontId", "familyDigest", "displayName", "faces"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "kind": { "const": "fontRecord" },
    "localId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "portableFontId": {
      "type": "string",
      "pattern": "^font:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "familyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256 over RFC 8785 canonical array of face records sorted by face id."
    },
    "displayName": { "type": "string", "minLength": 1 },
    "familyName": { "type": "string" },
    "internalName": { "type": "string" },
    "postScriptName": { "type": "string" },
    "licenseId": { "type": "string" },
    "redistributionAsserted": { "type": "boolean" },
    "exportable": { "type": "boolean" },
    "pdfEmbeddingPermitted": { "type": "boolean" },
    "pdfSubsettingPermitted": { "type": "boolean" },
    "validationState": { "enum": ["validated", "unvalidated", "failed"] },
    "validatingAppVersion": { "type": "string" },
    "validatingTypstVersion": { "type": "string" },
    "unicodeCoverageSummary": { "type": "string" },
    "faces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["faceId", "faceIndex", "format", "weight", "style", "hash", "byteSize"],
        "properties": {
          "faceId": { "type": "string", "minLength": 1 },
          "faceIndex": { "type": "integer", "minimum": 0 },
          "format": { "enum": ["ttf", "otf", "woff", "woff2"] },
          "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
          "style": { "enum": ["normal", "italic", "oblique"] },
          "stretch": { "type": "number", "exclusiveMinimum": 0 },
          "variableAxisCoordinates": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "byteSize": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
