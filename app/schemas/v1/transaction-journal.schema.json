{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://church-bulletin-builder.local/schema/v1/transaction-journal.schema.json",
  "title": "CBB Multi-Resource Transaction Journal",
  "description": "Durable seven-state journal. Payload bytes are stored separately under the transaction id and verified against the hashes recorded here.",
  "type": "object",
  "required": [
    "journalVersion",
    "transactionId",
    "state",
    "sourceDigest",
    "createdAt",
    "updatedAt",
    "allocations",
    "steps",
    "completedSteps",
    "visibleCommitStarted"
  ],
  "properties": {
    "journalVersion": { "type": "integer", "const": 1 },
    "transactionId": { "$ref": "#/$defs/safeId" },
    "state": {
      "enum": [
        "planned",
        "staged",
        "committing",
        "committed",
        "rollingBack",
        "rolledBack",
        "failed"
      ]
    },
    "sourceDigest": { "$ref": "#/$defs/sha256" },
    "createdAt": { "$ref": "#/$defs/utcTimestamp" },
    "updatedAt": { "$ref": "#/$defs/utcTimestamp" },
    "allocations": {
      "type": "object",
      "propertyNames": { "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "maxProperties": 100000
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" },
      "minItems": 1,
      "maxItems": 100000
    },
    "completedSteps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(stage-old|stage-new|commit|rollback):[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "maxItems": 400000
    },
    "visibleCommitStarted": { "type": "boolean" },
    "failure": {
      "type": "object",
      "required": ["message", "rollbackVerified"],
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "rollbackVerified": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "failed" } },
        "required": ["state"]
      },
      "then": {
        "properties": { "failure": true },
        "required": ["failure"]
      }
    },
    {
      "if": {
        "properties": {
          "state": { "enum": ["planned", "staged"] }
        },
        "required": ["state"]
      },
      "then": {
        "properties": { "visibleCommitStarted": { "const": false } }
      }
    },
    {
      "if": {
        "properties": {
          "state": { "enum": ["committing", "committed"] }
        },
        "required": ["state"]
      },
      "then": {
        "properties": { "visibleCommitStarted": { "const": true } }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "order",
        "resourceKey",
        "operation",
        "expectedOldHash",
        "expectedNewHash",
        "idempotent",
        "commitMarker"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "order": { "type": "integer", "minimum": 0 },
        "resourceKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000]+$"
        },
        "operation": { "enum": ["put", "delete"] },
        "expectedOldHash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "expectedNewHash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "idempotent": { "type": "boolean" },
        "commitMarker": { "type": "boolean" },
        "oldPayloadId": { "type": "string", "pattern": "^old-[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "newPayloadId": { "type": "string", "pattern": "^new-[A-Za-z0-9][A-Za-z0-9_-]*$" }
      },
      "additionalProperties": false
    }
  }
}
