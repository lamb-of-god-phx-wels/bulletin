{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://church-bulletin-builder.local/schema/v1/trusted-components.schema.json",
  "title": "CBB Signed Trusted Component Manifest",
  "description": "Signed, application-release-bound identities for executables, bundled fonts, schemas, locale data, and starter resources. Paths are fixed safe relative package paths and never supplied by build requests; release identity and sequence prevent cross-profile or rollback substitution.",
  "type": "object",
  "required": [
    "version",
    "kind",
    "signingKeyId",
    "release",
    "components",
    "signature"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "trustedComponentManifest"
    },
    "signingKeyId": {
      "$ref": "#/$defs/token"
    },
    "release": {
      "$ref": "#/$defs/releaseIdentity"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$",
      "description": "Canonical base64 encoding of a 64-byte Ed25519 signature over RFC 8785 canonical manifest content with this field omitted."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "componentRole": {
      "enum": [
        "executionBroker",
        "quarantineWorker",
        "typstCli",
        "typstRuntimeClosure",
        "pdfInspector",
        "pdfStructuralInspector",
        "pdfFlattener",
        "pdfRuntimeClosure",
        "bookletCompositor",
        "pdfUaValidator",
        "bundledFontFace",
        "schemaCatalog",
        "localeData",
        "genericStarterSet"
      ]
    },
    "releaseIdentity": {
      "type": "object",
      "required": [
        "applicationId",
        "releaseId",
        "releaseSequence",
        "profile"
      ],
      "properties": {
        "applicationId": {
          "$ref": "#/$defs/token"
        },
        "releaseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+:-]{0,127}$"
        },
        "releaseSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "profile": {
          "$ref": "#/$defs/token"
        }
      },
      "additionalProperties": false
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*\\.\\.)(?:[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9_-])?/)*[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9_-])?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "component": {
      "type": "object",
      "required": [
        "role",
        "id",
        "version",
        "platform",
        "arch",
        "relativePath",
        "hash",
        "byteSize"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/componentRole"
        },
        "id": {
          "$ref": "#/$defs/token"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+:-]{0,127}$"
        },
        "platform": {
          "enum": [
            "linux",
            "win32"
          ]
        },
        "arch": {
          "enum": [
            "x64",
            "arm64"
          ]
        },
        "relativePath": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "fontFaceBinding": {
          "$ref": "#/$defs/fontFaceBinding"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "bundledFontFace"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "fontFaceBinding": true
            },
            "required": [
              "fontFaceBinding"
            ]
          },
          "else": {
            "properties": {
              "fontFaceBinding": false
            }
          }
        }
      ]
    },
    "portableFontRef": {
      "type": "string",
      "pattern": "^font:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "faceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "fontFaceBinding": {
      "type": "object",
      "required": [
        "portableFontRef",
        "familyName",
        "faceId",
        "faceIndex",
        "format",
        "weight",
        "style",
        "stretch"
      ],
      "properties": {
        "portableFontRef": {
          "$ref": "#/$defs/portableFontRef"
        },
        "familyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069]+$"
        },
        "faceId": {
          "$ref": "#/$defs/faceId"
        },
        "faceIndex": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "enum": [
            "ttf",
            "otf",
            "woff",
            "woff2"
          ]
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        },
        "style": {
          "enum": [
            "normal",
            "italic",
            "oblique"
          ]
        },
        "stretch": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
