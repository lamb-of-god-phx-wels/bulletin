{
  "schemaVersion": 1,
  "id": "church-information",
  "version": 1,
  "name": "Church information page",
  "description": "The standard welcome and church information page.",
  "icon": "T",
  "order": 100,
  "block": {
    "id": "root",
    "type": "churchInfo",
    "layout": { "keepTogether": true, "density": "normal" },
    "presentation": {
      "widthPercent": 100,
      "placement": "left",
      "textAlign": "left",
      "paddingIn": { "top": 0, "right": 0, "bottom": 0, "left": 0 },
      "marginIn": { "top": 0, "bottom": 0 },
      "fontFamily": "body",
      "fontSizePt": 10,
      "lineHeight": 1.28,
      "fontWeight": "normal",
      "fontStyle": "normal",
      "textTransform": "none",
      "color": "#25302d",
      "borderWidthPt": 0,
      "borderColor": "#a44d2a",
      "borderRadiusPt": 0
    },
    "children": [
      {
        "id": "tagline",
        "type": "paragraph",
        "presentation": {
          "fontStyle": "italic",
          "color": "#696d68",
          "marginIn": { "top": 0, "bottom": 0.18 }
        },
        "children": [
          {
            "id": "body",
            "type": "richText",
            "role": "body",
            "content": [
              {
                "type": "paragraph",
                "children": [{ "type": "text", "text": "Reaching Up. Reaching Out. Reaching Across." }]
              }
            ],
            "presentation": {
              "marginIn": { "top": 0, "bottom": 0 },
              "paddingIn": { "top": 0, "right": 0, "bottom": 0, "left": 0 }
            }
          }
        ]
      },
      {
        "id": "welcome",
        "type": "paragraph",
        "children": [
          {
            "id": "header",
            "type": "richText",
            "role": "header",
            "content": [
              {
                "type": "paragraph",
                "children": [{ "type": "text", "text": "Welcome" }]
              }
            ],
            "presentation": {
              "fontWeight": "bold",
              "textTransform": "uppercase",
              "marginIn": { "top": 0, "bottom": 0.035 },
              "paddingIn": { "top": 0, "right": 0, "bottom": 0, "left": 0 }
            }
          },
          {
            "id": "body",
            "type": "richText",
            "role": "body",
            "content": [
              {
                "type": "paragraph",
                "children": [{ "type": "text", "text": "Thank you for joining us for worship. We gather before our almighty God to offer him our worship and praise and to strengthen ourselves through his holy and powerful Word." }]
              }
            ],
            "presentation": {
              "marginIn": { "top": 0, "bottom": 0 },
              "paddingIn": { "top": 0, "right": 0, "bottom": 0, "left": 0 }
            }
          }
        ]
      },
      {
        "id": "children",
        "type": "paragraph",
        "children": [
          {
            "id": "header",
            "type": "richText",
            "role": "header",
            "content": [
              {
                "type": "paragraph",
                "children": [{ "type": "text", "text": "Children’s Room" }]
              }
            ],
            "presentation": {
              "fontWeight": "bold",
              "textTransform": "uppercase",
              "marginIn": { "top": 0, "bottom": 0.035 },
              "paddingIn": { "top": 0, "right": 0, "bottom": 0, "left": 0 }
            }
          },
          {
            "id": "body",
            "type": "richText",
            "role": "body",
            "content": [
              {
                "type": "paragraph",
                "children": [{ "type": "text", "text": "Children are always welcome in worship. A children’s room is available for families who need it." }]
              }
            ],
            "presentation": {
              "marginIn": { "top": 0, "bottom": 0 },
              "paddingIn": { "top": 0, "right": 0, "bottom": 0, "left": 0 }
            }
          }
        ]
      },
      {
        "id": "contact",
        "type": "paragraph",
        "presentation": {
          "textAlign": "center",
          "paddingIn": { "top": 0.25, "right": 0.25, "bottom": 0.25, "left": 0.25 },
          "marginIn": { "top": 0.4, "bottom": 0 },
          "borderWidthPt": 1,
          "borderColor": "#d8d4cb"
        },
        "children": [
          {
            "id": "body",
            "type": "richText",
            "role": "body",
            "content": [
              {
                "type": "paragraph",
                "children": [{ "type": "text", "text": "Church information is maintained in the shared content library." }]
              }
            ],
            "presentation": {
              "marginIn": { "top": 0, "bottom": 0 },
              "paddingIn": { "top": 0, "right": 0, "bottom": 0, "left": 0 }
            }
          }
        ]
      }
    ]
  }
