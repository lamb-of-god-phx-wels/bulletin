{
  "schemaVersion": 1,
  "id": "paragraph",
  "version": 1,
  "name": "Paragraph",
  "description": "Body text with an optional tightly coupled header.",
  "icon": "T",
  "order": 40,
  "block": {
    "id": "root",
    "type": "paragraph",
    "weeklyEditable": true,
    "layout": { "keepTogether": true, "density": "normal" },
    "presentation": {
      "widthPercent": 100,
      "placement": "left",
      "textAlign": "left",
      "paddingIn": { "top": 0, "right": 0, "bottom": 0, "left": 0 },
      "marginIn": { "top": 0, "bottom": 0.16 },
      "fontFamily": "body",
      "fontSizePt": 10,
      "lineHeight": 1.28,
      "fontWeight": "normal",
      "fontStyle": "normal",
      "textTransform": "none",
      "color": "#25302d",
      "borderWidthPt": 0,
      "borderColor": "#a44d2a",
      "borderRadiusPt": 0
    },
    "children": [
      {
        "id": "header",
        "type": "richText",
        "role": "header",
        "content": [
          {
            "type": "paragraph",
            "children": [{ "type": "text", "text": "New heading" }]
          }
        ],
        "presentation": {
          "fontWeight": "bold",
          "marginIn": { "top": 0, "bottom": 0 },
          "paddingIn": { "top": 0, "right": 0, "bottom": 0, "left": 0 }
        }
      },
      {
        "id": "body",
        "type": "richText",
        "role": "body",
        "content": [
          {
            "type": "paragraph",
            "children": [{ "type": "text", "text": "New paragraph" }]
          }
        ],
        "presentation": {
          "marginIn": { "top": 0, "bottom": 0 },
          "paddingIn": { "top": 0, "right": 0, "bottom": 0, "left": 0 }
        }
      }
    ]
  }
}
