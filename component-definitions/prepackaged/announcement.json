{
  "schemaVersion": 2,
  "kind": "component",
  "type": "bulletin:announcement",
  "version": 1,
  "name": "Announcement",
  "description": "One announcement with an optional heading and image.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["body"],
    "properties": {
      "heading": { "type": ["string", "null"] },
      "body": { "type": "object", "required": ["blocks"], "properties": { "blocks": { "type": "array" } } },
      "image": { "type": ["object", "null"] }
    },
    "additionalProperties": false
  },
  "template": {
    "type": "core:stack",
    "id": "root",
    "children": [
      {
        "type": "bulletin:paragraph",
        "id": "copy",
        "inputs": {
          "heading": { "$bind": "inputs.heading" },
          "body": { "$bind": "inputs.body", "required": true }
        }
      },
      {
        "type": "core:image",
        "id": "image",
        "part": "image",
        "when": { "$expr": { "op": "notEmpty", "args": [{ "$bind": "inputs.image" }] } },
        "inputs": {
          "source": { "$bind": "inputs.image" },
          "fit": "contain",
          "altText": "Announcement image"
        }
      }
    ]
  },
  "defaultStyles": {
    "root": { "widthPercent": 100, "marginIn": { "bottom": 0.16 }, "keepTogether": true },
    "parts": { "image": { "widthPercent": 100, "marginIn": { "top": 0.08 } } }
  },
  "editor": {
    "icon": "A",
    "palette": false,
    "fields": [
      { "input": "heading", "label": "Heading", "control": "text", "optional": true },
      { "input": "body", "label": "Announcement", "control": "structuredText" },
      { "input": "image", "label": "Image", "control": "asset", "optional": true }
    ]
  },
  "sampleInputs": {
    "heading": "New announcement",
    "body": {
      "blocks": [
        { "type": "paragraph", "inlines": [{ "type": "text", "value": "Add announcement details here." }] }
      ]
    }
  }
}
