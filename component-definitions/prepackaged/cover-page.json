{
  "schemaVersion": 2,
  "kind": "component",
  "type": "bulletin:coverPage",
  "version": 1,
  "name": "Canvas cover page",
  "description": "A precisely positioned, full-page cover with editable text, images, shapes, and bindings.",
  "inputSchema": {
    "type": "object",
    "required": ["scene"],
    "properties": {
      "scene": { "type": "object" }
    }
  },
  "template": {
    "type": "core:canvas",
    "part": "canvas",
    "inputs": {
      "scene": { "$bind": "inputs.scene", "required": true }
    }
  },
  "editor": {
    "icon": "▱",
    "palette": true,
    "fields": [
      { "input": "scene", "label": "Canvas scene", "control": "collection" }
    ]
  },
  "sampleInputs": {
    "scene": {
      "coordinateSpace": "fullPage",
      "background": { "color": "#ffffff" },
      "elements": [
        {
          "id": "cover-title",
          "name": "Sermon title",
          "type": "text",
          "x": 1,
          "y": 3.45,
          "width": 5,
          "height": 0.75,
          "source": { "binding": "info.title" },
          "fontSizePt": 17,
          "fontWeight": "bold",
          "textAlign": "center",
          "verticalAlign": "middle",
          "overflow": "shrinkToFit"
        }
      ]
    }
  }
}
