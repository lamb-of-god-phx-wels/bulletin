{
  "schemaVersion": 2,
  "kind": "component",
  "type": "bulletin:heading",
  "version": 2,
  "name": "Heading",
  "description": "An H1, H2, or H3 heading with optional subheading and caption.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["level", "text"],
    "properties": {
      "level": { "enum": ["h1", "h2", "h3"] },
      "text": { "type": "string" },
      "subheading": { "type": ["string", "null"] },
      "caption": { "type": ["string", "null"] }
    },
    "additionalProperties": false
  },
  "template": {
    "type": "core:stack",
    "id": "root",
    "children": [
      {
        "type": "core:text",
        "id": "text",
        "part": "text",
        "inputs": { "text": { "$bind": "inputs.text", "required": true } }
      },
      {
        "type": "core:text",
        "id": "subheading",
        "part": "subheading",
        "when": { "$expr": { "op": "notEmpty", "args": [{ "$bind": "inputs.subheading" }] } },
        "inputs": { "text": { "$bind": "inputs.subheading" } }
      },
      {
        "type": "core:text",
        "id": "caption",
        "part": "caption",
        "when": { "$expr": { "op": "notEmpty", "args": [{ "$bind": "inputs.caption" }] } },
        "inputs": { "text": { "$bind": "inputs.caption" } }
      }
    ]
  },
  "defaultStyles": {
    "root": {
      "keepTogether": true
    },
    "parts": {
      "text": { "fontWeight": "bold", "keepWithNext": true },
      "subheading": { "fontStyle": "italic", "keepWithNext": true },
      "caption": { "fontSizePt": 9, "color": "#696d68" }
    }
  },
  "editor": {
    "icon": "H",
    "fields": [
      { "input": "level", "label": "Level", "control": "select" },
      { "input": "text", "label": "Heading", "control": "text" },
      { "input": "subheading", "label": "Subheading", "control": "text", "optional": true },
      { "input": "caption", "label": "Caption", "control": "textarea", "optional": true }
    ]
  },
  "sampleInputs": {
    "level": "h2",
    "text": "New heading",
    "subheading": null,
    "caption": null
  }
}
