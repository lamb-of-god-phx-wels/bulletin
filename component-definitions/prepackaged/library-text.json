{
  "schemaVersion": 2,
  "kind": "component",
  "type": "bulletin:libraryText",
  "version": 1,
  "name": "Reusable library text",
  "description": "Approved structured text selected from the shared content library.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["content"],
    "properties": {
      "title": { "type": ["string", "null"] },
      "content": { "type": "object", "required": ["blocks"], "properties": { "blocks": { "type": "array" } } },
      "libraryItemId": { "type": ["string", "null"] },
      "libraryItemVersion": { "type": ["integer", "null"], "minimum": 1 }
    },
    "additionalProperties": false
  },
  "template": {
    "type": "core:stack",
    "id": "root",
    "children": [
      {
        "type": "core:text",
        "id": "title",
        "part": "title",
        "when": { "$expr": { "op": "notEmpty", "args": [{ "$bind": "inputs.title" }] } },
        "inputs": { "text": { "$bind": "inputs.title" } }
      },
      {
        "type": "core:structuredText",
        "id": "content",
        "part": "content",
        "inputs": { "content": { "$bind": "inputs.content", "required": true } }
      }
    ]
  },
  "defaultStyles": {
    "root": {
      "widthPercent": 100,
      "marginIn": { "bottom": 0.12 },
      "fontFamily": "body",
      "fontSizePt": 10,
      "lineHeight": 1.28,
      "color": "#25302d",
      "keepTogether": true
    },
    "parts": {
      "title": { "fontWeight": "bold", "marginIn": { "bottom": 0.04 }, "keepWithNext": true }
    }
  },
  "editor": {
    "icon": "L",
    "fields": [
      { "input": "title", "label": "Title", "control": "text", "optional": true },
      { "input": "content", "label": "Content", "control": "structuredText" },
      { "input": "libraryItemId", "label": "Library item", "control": "text", "optional": true },
      { "input": "libraryItemVersion", "label": "Library version", "control": "number", "optional": true }
    ]
  },
  "sampleInputs": {
    "title": "Reusable text",
    "content": {
      "blocks": [
        { "type": "paragraph", "inlines": [{ "type": "text", "value": "Choose approved text from the shared library." }] }
      ]
    }
  }
}
