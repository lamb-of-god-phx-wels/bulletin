{
  "schemaVersion": 2,
  "kind": "component",
  "type": "bulletin:paragraph",
  "version": 1,
  "name": "Paragraph",
  "description": "Body text with an optional, tightly coupled heading.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["body"],
    "properties": {
      "heading": { "type": ["string", "null"] },
      "body": { "type": "object", "required": ["blocks"], "properties": { "blocks": { "type": "array" } } }
    },
    "additionalProperties": false
  },
  "template": {
    "type": "core:stack",
    "id": "root",
    "children": [
      {
        "type": "core:text",
        "id": "heading",
        "part": "heading",
        "when": { "$expr": { "op": "notEmpty", "args": [{ "$bind": "inputs.heading" }] } },
        "inputs": { "text": { "$bind": "inputs.heading" } }
      },
      {
        "type": "core:structuredText",
        "id": "body",
        "part": "body",
        "inputs": { "content": { "$bind": "inputs.body", "required": true } }
      }
    ]
  },
  "defaultStyles": {
    "root": {
      "widthPercent": 100,
      "marginIn": { "bottom": 0.16 },
      "fontFamily": "body",
      "fontSizePt": 10,
      "lineHeight": 1.28,
      "color": "#25302d",
      "keepTogether": true
    },
    "parts": {
      "heading": {
        "marginIn": { "top": 0, "bottom": 0 },
        "fontWeight": "bold",
        "keepWithNext": true
      },
      "body": { "marginIn": { "top": 0, "bottom": 0 } }
    }
  },
  "editor": {
    "icon": "¶",
    "fields": [
      { "input": "heading", "label": "Heading", "control": "text", "optional": true },
      { "input": "body", "label": "Paragraph", "control": "structuredText" }
    ]
  },
  "sampleInputs": {
    "heading": "New heading",
    "body": {
      "blocks": [
        { "type": "paragraph", "inlines": [{ "type": "text", "value": "New paragraph" }] }
      ]
    }
  }
}
