{
  "schemaVersion": 2,
  "kind": "component",
  "type": "bulletin:sectionHeading",
  "version": 1,
  "name": "Section heading",
  "description": "A centered divider for a major service section.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["text"],
    "properties": { "text": { "type": "string" } },
    "additionalProperties": false
  },
  "template": {
    "type": "core:text",
    "id": "text",
    "part": "text",
    "inputs": { "text": { "$bind": "inputs.text", "required": true } }
  },
  "defaultStyles": {
    "root": {
      "widthPercent": 100,
      "placement": "center",
      "textAlign": "center",
      "marginIn": { "top": 0.18, "bottom": 0.24 },
      "fontFamily": "display",
      "fontSizePt": 13,
      "lineHeight": 1.28,
      "fontWeight": "bold",
      "color": "#25302d",
      "keepTogether": true
    }
  },
  "editor": {
    "icon": "H",
    "fields": [{ "input": "text", "label": "Heading", "control": "text" }]
  },
  "sampleInputs": { "text": "New section" }
}
