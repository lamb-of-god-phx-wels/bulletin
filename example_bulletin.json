    {
      "id": "prayer-of-the-day",
      "type": "heading",
      "text": "Prayer of the Day"
    },
    {
      "id": "responsivereading-4",
      "type": "responsiveReading",
      "entries": [
        {
          "reader": "M",
          "content": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "Almighty and merciful God, you sent your Son, Jesus Christ, to seek and to save the lost. Graciously open our ears and our hearts to hear his call and follow him by faith that we may feast with him forever in his kingdom; through your Son, Jesus Christ our Lord, who lives and reigns with you and the Holy Spirit, one God, now and forever."
                }
              ]
            }
          ]
        },
        {
          "reader": "C",
          "content": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "Amen."
                }
              ]
            }
          ]
        }
      ]
    },
