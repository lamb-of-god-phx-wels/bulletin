    {
      "id": "blessing",
      "type": "heading",
      "text": "Blessing"
    },
    {
      "id": "responsivereading-5",
      "type": "responsiveReading",
      "entries": [
        {
          "reader": "M",
          "content": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "Brothers and sisters, go in peace."
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "Live in harmony with one another."
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "Serve the Lord with gladness."
                }
              ]
            },
            {
              "type": "paragraph",
              "children": []
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "The Lord bless you and keep you."
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "The Lord make his face shine on you and be gracious to you."
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "The Lord look on you with favor and give "
                },
                {
                  "type": "symbol",
                  "name": "cross"
                },
                {
                  "type": "text",
                  "text": " you peace."
                }
              ]
            }
          ]
        },
        {
          "reader": "C",
          "content": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "text": "Amen."
                }
              ]
            }
          ]
        }
