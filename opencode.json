{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["skills/"]
  },
  "permission": {
    "read": {
      "assets/church/information.md": "deny",
      "**/private-data.tex": "deny",
      "**/bulletin.log": "deny",
      "**/bulletin.pdf": "deny",
      "**/bulletin.out": "deny",
      "pdf/**": "deny",
      "*": "allow"
    },
    "grep": {
      "assets/church/information.md": "deny",
      "**/private-data.tex": "deny",
      "*": "allow"
    },
    "edit": {
      "assets/church/information.md": "deny",
      "**/private-data.tex": "deny",
      "*": "allow"
    },
    "bash": {
      "*information.md*": "deny",
      "*private-data.tex*": "deny",
      "*": "allow"
    }
  }
}
