{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:typst-bulletin,2026:schema/imageElement.schema.json",
  "title": "Image Element",
  "description": "An image element for logos, artwork, and photos.",
  "type": "object",
  "required": ["id", "type", "name", "width", "height", "margin", "padding", "style", "schema", "data"],
  "properties": {
    "id": { "$ref": "#/$defs/identifier" },
    "type": { "const": "image" },
    "name": { "type": "string", "minLength": 1 },
    "width": { "$ref": "#/$defs/size" },
    "height": { "$ref": "#/$defs/size" },
    "margin": { "$ref": "#/$defs/spacing" },
    "padding": { "$ref": "#/$defs/spacing" },
    "style": { "$ref": "#/$defs/boxStyle" },
    "schema": { "type": "array", "items": { "$ref": "#/$defs/dataField" }, "default": [] },
    "data": {
      "type": "object",
      "required": ["path", "fit"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "fit": { "enum": ["contain", "cover", "stretch"], "default": "contain" },
        "alt": { "type": "string" },
        "caption": { "type": "string" }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/binding", "x-compatibleFieldTypes": ["image"] },
        "alt": { "$ref": "#/$defs/binding", "x-compatibleFieldTypes": ["text"] },
        "caption": { "$ref": "#/$defs/binding", "x-compatibleFieldTypes": ["text", "richText"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "size": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "auto" }, { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%|fr)$" }] },
    "spacing": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%)$" }] },
    "boxStyle": {
      "type": "object",
      "properties": {
        "font": { "type": "string" },
        "fontSize": { "$ref": "#/$defs/size" },
        "fontWeight": { "enum": ["regular", "medium", "semibold", "bold"] },
        "fontStyle": { "enum": ["normal", "italic"] },
        "color": { "type": "string" },
        "background": { "type": "string", "default": "transparent" },
        "borderColor": { "type": "string" },
        "borderWidth": { "$ref": "#/$defs/spacing" },
        "align": { "enum": ["left", "center", "right", "justify"] },
        "verticalAlign": { "enum": ["top", "center", "bottom"] }
      },
      "additionalProperties": false
    },
    "dataField": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "richText", "image", "music", "number", "boolean", "date", "choice", "list"] },
        "required": { "type": "boolean", "default": false },
        "defaultValue": true
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["fieldId"],
      "properties": {
        "fieldId": { "$ref": "#/$defs/identifier" },
        "fallback": true,
        "format": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
