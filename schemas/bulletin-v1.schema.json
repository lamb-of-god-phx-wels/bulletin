{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mylambofgod.org/schemas/bulletin-v1.schema.json",
  "title": "BulletinDocumentV1",
  "type": "object",
  "required": ["schemaVersion", "id", "revision", "template", "church", "info", "blocks", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "template": { "type": "object", "required": ["id", "version"], "properties": { "id": { "type": "string" }, "version": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "church": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } }, "additionalProperties": false },
    "info": { "type": "object", "required": ["title", "date", "churchWeek"], "properties": { "title": { "type": "string" }, "series": { "type": "string" }, "date": { "type": "string", "format": "date" }, "churchWeek": { "type": "string" }, "churchEventId": { "type": "string" } }, "additionalProperties": false },
    "layout": { "type": "object", "properties": { "marginIn": { "type": "number", "minimum": 0, "maximum": 1.25 } }, "additionalProperties": false },
    "responsiveReading": { "$ref": "#/$defs/responsiveReadingSettings" },
    "customProperties": { "type": "array", "items": { "$ref": "#/$defs/customProperty" } },
    "customPropertyOverrides": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
    "sourceNotes": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "responsiveReadingSettings": {
      "type": "object",
      "required": ["labels"],
      "properties": {
        "labels": {
          "type": "object",
          "required": ["leader", "follower", "all"],
          "properties": {
            "leader": { "type": "string", "minLength": 1, "pattern": "^[^:\\r\\n]+$" },
            "follower": { "type": "string", "minLength": 1, "pattern": "^[^:\\r\\n]+$" },
            "all": { "type": "string", "minLength": 1, "pattern": "^[^:\\r\\n]+$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["canvas", "templatePage", "templateInstance", "churchInfo", "heading", "sectionHeading", "paragraph", "richText", "sermonTitle", "responsiveReading", "scriptureReading", "song", "libraryText", "announcements", "list", "copyright", "image", "fullPageAsset", "spacer", "group", "custom"] },
        "label": { "type": "string" },
        "weeklyEditable": { "type": "boolean" },
        "layout": { "type": "object" },
        "presentation": { "type": "object" },
        "elements": {
          "type": "object",
          "properties": {
            "heading": { "$ref": "#/$defs/elementFormatting" },
            "reference": { "$ref": "#/$defs/elementFormatting" },
            "caption": { "$ref": "#/$defs/elementFormatting" },
            "body": { "$ref": "#/$defs/elementFormatting" }
          },
          "additionalProperties": false
        },
        "name": { "type": "string", "minLength": 1 },
        "definitionId": { "type": "string" },
        "showName": { "type": "boolean" },
        "layoutText": { "type": "string", "minLength": 1 },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/customBinding" } },
        "values": { "type": "object", "additionalProperties": { "type": "string" } },
        "style": { "type": "object" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "layoutMode": { "enum": ["stack", "grid", "table"] },
        "columns": { "type": "integer", "minimum": 1, "maximum": 12 },
        "gapIn": { "type": "number", "minimum": 0, "maximum": 2 },
        "scene": { "$ref": "#/$defs/canvasScene" },
        "condition": { "$ref": "#/$defs/condition" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "custom" } }, "required": ["type"] }, "then": { "required": ["name", "layoutText", "bindings"] } }
      ],
      "additionalProperties": true
    },
    "customPropertyBinding": {
      "type": "object",
      "required": ["kind", "propertyId", "propertyName", "valueType"],
      "properties": {
        "kind": { "const": "customProperty" },
        "propertyId": { "type": "string", "minLength": 1 },
        "propertyName": { "type": "string", "minLength": 1 },
        "valueType": { "enum": ["string", "number", "boolean"] }
      },
      "additionalProperties": false
    },
    "condition": { "type": "object", "required": ["property", "equals"], "properties": { "property": { "$ref": "#/$defs/customPropertyBinding" }, "equals": { "type": "boolean" } }, "additionalProperties": false },
    "customProperty": {
      "type": "object",
      "required": ["id", "name", "valueType", "defaultValue"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "valueType": { "enum": ["string", "number", "boolean"] },
        "defaultValue": {},
        "includeInThisSunday": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "valueType": { "const": "string" } } }, "then": { "properties": { "defaultValue": { "type": "string" } } } },
        { "if": { "properties": { "valueType": { "const": "number" } } }, "then": { "properties": { "defaultValue": { "type": "number" } } } },
        { "if": { "properties": { "valueType": { "const": "boolean" } } }, "then": { "properties": { "defaultValue": { "type": "boolean" } } } }
      ],
      "additionalProperties": false
    },
    "elementFormatting": {
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "layout": { "type": "object" },
        "presentation": { "type": "object" },
        "condition": { "$ref": "#/$defs/condition" }
      },
      "additionalProperties": false
    },
    "customBinding": {
      "type": "object",
      "required": ["key", "label", "source"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "source": { "oneOf": [{ "enum": ["weekly", "info.title", "info.date", "info.churchWeek", "info.churchEvent", "info.series", "church.name"] }, { "$ref": "#/$defs/customPropertyBinding" }] },
        "defaultValue": { "type": "string" },
        "multiline": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "canvasScene": {
      "type": "object",
      "required": ["coordinateSpace", "elements"],
      "properties": {
        "coordinateSpace": { "enum": ["fullPage", "contentBox"] },
        "background": { "type": "object" },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "x", "y", "width", "height"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "enum": ["block", "shape", "text", "image", "rectangle", "line"] },
              "block": { "$ref": "#/$defs/block" },
              "shape": { "enum": ["rectangle", "line"] },
              "condition": { "$ref": "#/$defs/condition" },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
