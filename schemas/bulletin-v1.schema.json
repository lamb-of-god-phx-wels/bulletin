{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mylambofgod.org/schemas/bulletin-v1.schema.json",
  "title": "BulletinDocumentV1",
  "type": "object",
  "required": ["schemaVersion", "id", "revision", "template", "church", "info", "blocks", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "template": { "type": "object", "required": ["id", "version"], "properties": { "id": { "type": "string" }, "version": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "church": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } }, "additionalProperties": false },
    "info": { "type": "object", "required": ["title", "date", "churchWeek"], "properties": { "title": { "type": "string" }, "series": { "type": "string" }, "date": { "type": "string", "format": "date" }, "churchWeek": { "type": "string" } }, "additionalProperties": false },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
    "sourceNotes": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["titlePage", "churchInfo", "heading", "sectionHeading", "richText", "sermonTitle", "responsiveReading", "scriptureReading", "song", "libraryText", "announcements", "copyright", "fullPageAsset", "spacer", "custom"] },
        "label": { "type": "string" },
        "weeklyEditable": { "type": "boolean" },
        "layout": { "type": "object" },
        "name": { "type": "string", "minLength": 1 },
        "definitionId": { "type": "string" },
        "showName": { "type": "boolean" },
        "layoutText": { "type": "string", "minLength": 1 },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/customBinding" } },
        "values": { "type": "object", "additionalProperties": { "type": "string" } },
        "style": { "type": "object" }
      },
      "allOf": [{ "if": { "properties": { "type": { "const": "custom" } }, "required": ["type"] }, "then": { "required": ["name", "layoutText", "bindings"] } }],
      "additionalProperties": true
    },
    "customBinding": {
      "type": "object",
      "required": ["key", "label", "source"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "source": { "enum": ["weekly", "info.title", "info.date", "info.churchWeek", "info.series", "church.name"] },
        "defaultValue": { "type": "string" },
        "multiline": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
