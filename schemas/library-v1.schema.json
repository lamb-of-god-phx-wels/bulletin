{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mylambofgod.org/schemas/library-v1.schema.json",
  "title": "LibraryManifestV1",
  "type": "object",
  "required": ["schemaVersion", "name", "items"],
  "properties": {
    "schemaVersion": { "const": 1 }, "name": { "type": "string" },
    "items": { "type": "array", "items": { "type": "object", "required": ["id", "version", "kind", "title"], "properties": { "id": { "type": "string" }, "version": { "type": "integer", "minimum": 1 }, "kind": { "enum": ["song", "liturgy", "image", "font", "church-info"] }, "title": { "type": "string" } }, "additionalProperties": true } },
    "componentDefinitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schemaVersion", "kind", "type", "version", "name", "description", "inputSchema", "template"],
        "properties": {
          "schemaVersion": { "const": 2 },
          "kind": { "const": "component" },
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][A-Za-z0-9-]*$" },
          "version": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "inputSchema": { "type": "object" },
          "template": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  }, "additionalProperties": false
}
