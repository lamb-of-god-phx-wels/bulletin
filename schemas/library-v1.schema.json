{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mylambofgod.org/schemas/library-v1.schema.json",
  "title": "LibraryManifestV1",
  "type": "object",
  "required": ["schemaVersion", "name", "items"],
  "properties": {
    "schemaVersion": { "const": 1 }, "name": { "type": "string" },
    "items": { "type": "array", "items": { "type": "object", "required": ["id", "version", "kind", "title"], "properties": { "id": { "type": "string" }, "version": { "type": "integer", "minimum": 1 }, "kind": { "enum": ["song", "liturgy", "image", "font", "church-info", "music"] }, "title": { "type": "string" } }, "additionalProperties": true } }
  }, "additionalProperties": false
}
