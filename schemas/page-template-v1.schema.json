{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mylambofgod.org/schemas/page-template-v1.schema.json",
  "title": "PageTemplateV1",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "name", "status", "margin", "blocks", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "published"] },
    "layout": { "enum": ["canvas", "regular"] },
    "margin": {
      "oneOf": [
        { "type": "object", "required": ["mode", "referenceMarginIn"], "properties": { "mode": { "const": "inherit" }, "referenceMarginIn": { "type": "number", "minimum": 0, "maximum": 1.25 } }, "additionalProperties": false },
        { "type": "object", "required": ["mode", "marginIn"], "properties": { "mode": { "const": "fixed" }, "marginIn": { "type": "number", "minimum": 0, "maximum": 1.25 } }, "additionalProperties": false }
      ]
    },
    "blocks": { "type": "array", "items": { "type": "object", "required": ["id", "type"], "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "not": { "enum": ["titlePage", "canvasCover", "templatePage"] } } }, "additionalProperties": true } },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
