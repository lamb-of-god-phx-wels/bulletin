{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mylambofgod.org/schemas/template-v1.schema.json",
  "title": "TemplateV1",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "name", "status", "page", "theme", "starterBlocks", "filler", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "type": "string" }, "version": { "type": "integer", "minimum": 1 }, "name": { "type": "string" },
    "status": { "enum": ["draft", "published"] },
    "page": { "type": "object", "required": ["widthIn", "heightIn", "pageMultiple"], "properties": { "widthIn": { "const": 7 }, "heightIn": { "const": 8.5 }, "pageMultiple": { "const": 4 } }, "additionalProperties": false },
    "theme": { "type": "object" }, "starterBlocks": { "type": "array" }, "filler": { "type": "object" }, "updatedAt": { "type": "string", "format": "date-time" }
  }, "additionalProperties": false
}
