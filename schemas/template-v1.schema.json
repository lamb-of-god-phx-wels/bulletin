{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mylambofgod.org/schemas/template-v1.schema.json",
  "title": "TemplateV1",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "name", "status", "page", "theme", "starterBlocks", "filler", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "type": "string" }, "version": { "type": "integer", "minimum": 1 }, "name": { "type": "string" },
    "status": { "enum": ["draft", "published"] },
    "page": { "type": "object", "required": ["widthIn", "heightIn", "pageMultiple"], "properties": { "widthIn": { "const": 7 }, "heightIn": { "const": 8.5 }, "pageMultiple": { "const": 4 } }, "additionalProperties": false },
    "theme": { "type": "object" }, "starterBlocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }, "filler": { "type": "object" }, "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["canvas", "templatePage", "churchInfo", "heading", "sectionHeading", "paragraph", "richText", "sermonTitle", "responsiveReading", "scriptureReading", "song", "libraryText", "announcements", "copyright", "image", "fullPageAsset", "spacer", "group", "custom"] },
        "presentation": { "type": "object" },
        "name": { "type": "string", "minLength": 1 },
        "layoutText": { "type": "string", "minLength": 1 },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/customBinding" } },
        "values": { "type": "object", "additionalProperties": { "type": "string" } },
        "scene": { "$ref": "#/$defs/canvasScene" }
      },
      "allOf": [{ "if": { "properties": { "type": { "const": "custom" } }, "required": ["type"] }, "then": { "required": ["name", "layoutText", "bindings"] } }],
      "additionalProperties": true
    },
    "customBinding": {
      "type": "object",
      "required": ["key", "label", "source"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "source": { "enum": ["weekly", "info.title", "info.date", "info.churchWeek", "info.churchEvent", "info.series", "church.name"] },
        "defaultValue": { "type": "string" },
        "multiline": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "canvasScene": {
      "type": "object",
      "required": ["coordinateSpace", "elements"],
      "properties": {
        "coordinateSpace": { "enum": ["fullPage", "contentBox"] },
        "background": { "type": "object" },
        "elements": { "type": "array", "items": { "type": "object", "required": ["id", "type", "x", "y", "width", "height"], "properties": { "block": { "$ref": "#/$defs/block" }, "shape": { "enum": ["rectangle", "line"] } }, "additionalProperties": true } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
