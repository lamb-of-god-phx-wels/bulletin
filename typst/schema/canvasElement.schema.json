{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:typst-bulletin,2026:schema/canvasElement.schema.json",
  "title": "Canvas Element",
  "description": "An invisible absolute-placement container. The editor shows a dashed border, and each child is wrapped with x/y placement inside the canvas.",
  "type": "object",
  "required": ["id", "type", "name", "width", "height", "margin", "padding", "style", "schema", "data", "children"],
  "properties": {
    "id": { "$ref": "#/$defs/identifier" },
    "type": { "const": "canvas" },
    "name": { "type": "string", "minLength": 1 },
    "width": { "$ref": "#/$defs/size" },
    "height": { "$ref": "#/$defs/size" },
    "margin": { "$ref": "#/$defs/spacing" },
    "padding": { "$ref": "#/$defs/spacing" },
    "style": { "$ref": "#/$defs/canvasStyle" },
    "schema": { "type": "array", "items": { "$ref": "#/$defs/dataField" }, "default": [] },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "default": {}
    },
    "children": {
      "type": "array",
      "description": "Canvas child wrappers. The wrapper owns x/y placement; the wrapped element owns its own size and data.",
      "items": { "$ref": "#/$defs/canvasChild" },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "size": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "auto" }, { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%|fr)$" }] },
    "spacing": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%)$" }] },
    "canvasChild": {
      "type": "object",
      "required": ["id", "x", "y", "element"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "x": { "$ref": "#/$defs/position" },
        "y": { "$ref": "#/$defs/position" },
        "element": {
          "type": "object",
          "description": "Wrapped visual element. Validation is performed by the matching element schema.",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "position": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%)$" }
      ]
    },
    "canvasStyle": {
      "type": "object",
      "properties": {
        "font": { "type": "string" },
        "fontSize": { "$ref": "#/$defs/size" },
        "fontWeight": { "enum": ["regular", "medium", "semibold", "bold"] },
        "fontStyle": { "enum": ["normal", "italic"] },
        "color": { "type": "string" },
        "background": { "type": "string" },
        "borderColor": { "type": "string" },
        "borderWidth": { "$ref": "#/$defs/spacing" },
        "align": { "enum": ["left", "center", "right", "justify"] },
        "verticalAlign": { "enum": ["top", "center", "bottom"] }
      },
      "additionalProperties": false
    },
    "dataField": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "richText", "image", "music", "number", "boolean", "date", "choice", "list"] },
        "required": { "type": "boolean", "default": false },
        "defaultValue": true
      },
      "additionalProperties": false
    }
  }
}
