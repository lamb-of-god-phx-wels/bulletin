{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:typst-bulletin,2026:schema/customElement.schema.json",
  "title": "Custom Element Schema",
  "description": "Defines a reusable custom element that can be added to templates and later filled with data in the bulletin builder.",
  "type": "object",
  "required": ["objectType", "version", "id", "name", "dataFields", "elements"],
  "properties": {
    "objectType": {
      "const": "elementSchema"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/identifier",
      "description": "Stable unique identifier for this custom element type."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "User-facing custom element name shown in the element palette."
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Optional palette grouping, such as Liturgy, Music, or Cover."
    },
    "dataFields": {
      "type": "array",
      "description": "Fields the user fills in when this custom element is used in a bulletin.",
      "items": {
        "$ref": "#/$defs/dataField"
      },
      "default": []
    },
    "elements": {
      "type": "array",
      "description": "Visual elements that make up this custom element. Bindings on these elements can point to dataFields.",
      "items": {
        "$ref": "#/$defs/visualElement"
      },
      "minItems": 1
    },
    "defaultPlacement": {
      "type": "object",
      "description": "Optional default size when this custom element is inserted into a template flow.",
      "properties": {
        "width": {
          "$ref": "#/$defs/size"
        },
        "height": {
          "$ref": "#/$defs/size"
        }
      },
      "additionalProperties": false
    },
    "previewData": {
      "type": "object",
      "description": "Optional sample data keyed by dataFields[].id for rendering a preview in the custom element editor.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "dataField": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier",
          "description": "Stable field key used by bindings and saved bulletin data."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "User-facing field label."
        },
        "type": {
          "enum": ["text", "richText", "image", "music", "number", "boolean", "date", "choice", "list"],
          "description": "Controls the bulletin data input widget and which visual element properties can bind to this field."
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "placeholder": {
          "type": "string"
        },
        "defaultValue": {
          "description": "Default data value used when this custom element is inserted.",
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "array" },
            { "type": "object" },
            { "type": "null" }
          ]
        },
        "options": {
          "type": "array",
          "description": "Allowed values for choice fields.",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "itemType": {
          "enum": ["text", "image", "music", "number", "date"],
          "description": "Item type for list fields."
        },
        "validation": {
          "type": "object",
          "properties": {
            "minLength": { "type": "integer", "minimum": 0 },
            "maxLength": { "type": "integer", "minimum": 0 },
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "pattern": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "choice" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "list" }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["itemType"]
          }
        }
      ],
      "additionalProperties": false
    },
    "visualElement": {
      "oneOf": [
        { "$ref": "#/$defs/textElement" },
        { "$ref": "#/$defs/imageElement" },
        { "$ref": "#/$defs/musicElement" },
        { "$ref": "#/$defs/gridElement" },
        { "$ref": "#/$defs/stackElement" }
      ]
    },
    "baseVisualElement": {
      "type": "object",
      "required": ["id", "type", "name", "width", "height"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": ["text", "image", "music", "grid", "stack"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "$ref": "#/$defs/size"
        },
        "height": {
          "$ref": "#/$defs/size"
        },
        "margin": {
          "$ref": "#/$defs/spacing"
        },
        "padding": {
          "$ref": "#/$defs/spacing"
        },
        "style": {
          "$ref": "#/$defs/style"
        }
      }
    },
    "textElement": {
      "allOf": [
        { "$ref": "#/$defs/baseVisualElement" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "text" },
            "data": { "$ref": "#/$defs/textData" },
            "bindings": { "$ref": "#/$defs/textBindings" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "imageElement": {
      "allOf": [
        { "$ref": "#/$defs/baseVisualElement" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "image" },
            "data": { "$ref": "#/$defs/imageData" },
            "bindings": { "$ref": "#/$defs/imageBindings" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "musicElement": {
      "allOf": [
        { "$ref": "#/$defs/baseVisualElement" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "music" },
            "data": { "$ref": "#/$defs/musicData" },
            "bindings": { "$ref": "#/$defs/musicBindings" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "gridElement": {
      "allOf": [
        { "$ref": "#/$defs/baseVisualElement" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "grid" },
            "data": { "$ref": "#/$defs/gridData" },
            "bindings": { "$ref": "#/$defs/gridBindings" },
            "children": {
              "type": "array",
              "description": "Optional child elements placed inside this grid.",
              "items": { "$ref": "#/$defs/visualElement" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stackElement": {
      "allOf": [
        { "$ref": "#/$defs/baseVisualElement" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "stack" },
            "data": { "$ref": "#/$defs/stackData" },
            "bindings": { "$ref": "#/$defs/stackBindings" },
            "children": {
              "type": "array",
              "description": "Optional child elements arranged by this stack.",
              "items": { "$ref": "#/$defs/visualElement" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "textData": {
      "type": "object",
      "properties": {
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "imageData": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "fit": { "enum": ["contain", "cover", "stretch"] },
        "alt": { "type": "string" },
        "caption": { "type": "string" }
      },
      "additionalProperties": false
    },
    "musicData": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "source": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "gridData": {
      "type": "object",
      "properties": {
        "rows": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "cellPadding": { "$ref": "#/$defs/spacing" },
        "cells": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "stackData": {
      "type": "object",
      "properties": {
        "direction": { "enum": ["horizontal", "vertical"] },
        "gap": { "$ref": "#/$defs/spacing" },
        "items": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "textBindings": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/binding",
          "x-compatibleFieldTypes": ["text", "richText", "number", "date", "choice"]
        }
      },
      "additionalProperties": false
    },
    "imageBindings": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/binding",
          "x-compatibleFieldTypes": ["image"]
        },
        "alt": {
          "$ref": "#/$defs/binding",
          "x-compatibleFieldTypes": ["text"]
        },
        "caption": {
          "$ref": "#/$defs/binding",
          "x-compatibleFieldTypes": ["text", "richText"]
        }
      },
      "additionalProperties": false
    },
    "musicBindings": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/binding",
          "x-compatibleFieldTypes": ["text", "choice"]
        },
        "source": {
          "$ref": "#/$defs/binding",
          "x-compatibleFieldTypes": ["music"]
        },
        "notes": {
          "$ref": "#/$defs/binding",
          "x-compatibleFieldTypes": ["text", "richText"]
        }
      },
      "additionalProperties": false
    },
    "gridBindings": {
      "type": "object",
      "properties": {
        "rows": {
          "$ref": "#/$defs/binding",
          "x-compatibleFieldTypes": ["number"]
        },
        "columns": {
          "$ref": "#/$defs/binding",
          "x-compatibleFieldTypes": ["number"]
        },
        "cells": {
          "$ref": "#/$defs/binding",
          "x-compatibleFieldTypes": ["list", "text", "richText"]
        }
      },
      "additionalProperties": false
    },
    "stackBindings": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/binding",
          "x-compatibleFieldTypes": ["choice"]
        },
        "items": {
          "$ref": "#/$defs/binding",
          "x-compatibleFieldTypes": ["list", "text", "richText"]
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "description": "Connects a visual element data property to a custom element data field. The fieldId must match dataFields[].id; compatible field types are described by x-compatibleFieldTypes on each binding property.",
      "required": ["fieldId"],
      "properties": {
        "fieldId": {
          "$ref": "#/$defs/identifier"
        },
        "fallback": {
          "description": "Static value used when the bound field is empty.",
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "array" },
            { "type": "object" },
            { "type": "null" }
          ]
        },
        "format": {
          "type": "string",
          "description": "Optional display format, such as a date or number format string."
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "font": { "type": "string" },
        "fontSize": { "$ref": "#/$defs/size" },
        "fontWeight": { "enum": ["regular", "medium", "semibold", "bold"] },
        "fontStyle": { "enum": ["normal", "italic"] },
        "color": { "type": "string" },
        "background": { "type": "string" },
        "borderColor": { "type": "string" },
        "borderWidth": { "$ref": "#/$defs/spacing" },
        "align": { "enum": ["left", "center", "right", "justify"] },
        "verticalAlign": { "enum": ["top", "center", "bottom"] }
      },
      "additionalProperties": false
    },
    "size": {
      "description": "Element size. Numbers are interpreted by the app in GUI units; strings may be auto, percentages, fractions, or Typst-compatible absolute lengths.",
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "const": "auto" },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%|fr)$" }
      ]
    },
    "spacing": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%)$" }
      ]
    }
  }
}
