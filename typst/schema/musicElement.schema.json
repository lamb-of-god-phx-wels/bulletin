{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:typst-bulletin,2026:schema/musicElement.schema.json",
  "title": "Music Element",
  "description": "Placeholder schema for a music or lead-sheet element. Import/render behavior is intentionally TBD.",
  "type": "object",
  "required": ["id", "type", "name", "x", "y", "width", "height", "margin", "padding", "style", "schema", "data"],
  "properties": {
    "id": { "$ref": "#/$defs/identifier" },
    "type": { "const": "music" },
    "name": { "type": "string", "minLength": 1 },
    "x": { "$ref": "#/$defs/position" },
    "y": { "$ref": "#/$defs/position" },
    "width": { "$ref": "#/$defs/size" },
    "height": { "$ref": "#/$defs/size" },
    "margin": { "$ref": "#/$defs/spacing" },
    "padding": { "$ref": "#/$defs/spacing" },
    "style": { "$ref": "#/$defs/textStyle" },
    "schema": { "type": "array", "items": { "$ref": "#/$defs/dataField" }, "default": [] },
    "data": {
      "type": "object",
      "required": ["title", "notes"],
      "properties": {
        "title": { "type": "string", "default": "Music / Lead Sheet" },
        "source": { "type": "string", "description": "Optional path or future import reference for the music source." },
        "notes": { "type": "string", "default": "Import support TBD" },
        "hymnNumber": { "type": "string" },
        "copyright": { "type": "string" }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "properties": {
        "title": { "$ref": "#/$defs/binding", "x-compatibleFieldTypes": ["text", "choice"] },
        "source": { "$ref": "#/$defs/binding", "x-compatibleFieldTypes": ["music"] },
        "notes": { "$ref": "#/$defs/binding", "x-compatibleFieldTypes": ["text", "richText"] },
        "hymnNumber": { "$ref": "#/$defs/binding", "x-compatibleFieldTypes": ["text", "number"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "position": { "oneOf": [{ "type": "number" }, { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%)$" }] },
    "size": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "auto" }, { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%|fr)$" }] },
    "spacing": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%)$" }] },
    "textStyle": {
      "type": "object",
      "properties": {
        "font": { "type": "string", "default": "Calibri" },
        "fontSize": { "$ref": "#/$defs/size" },
        "fontWeight": { "enum": ["regular", "medium", "semibold", "bold"] },
        "fontStyle": { "enum": ["normal", "italic"] },
        "color": { "type": "string", "default": "#251d18" },
        "background": { "type": "string", "default": "transparent" },
        "borderColor": { "type": "string" },
        "borderWidth": { "$ref": "#/$defs/spacing" },
        "align": { "enum": ["left", "center", "right", "justify"] },
        "verticalAlign": { "enum": ["top", "center", "bottom"] }
      },
      "additionalProperties": false
    },
    "dataField": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "richText", "image", "music", "number", "boolean", "date", "choice", "list"] },
        "required": { "type": "boolean", "default": false },
        "defaultValue": true
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["fieldId"],
      "properties": {
        "fieldId": { "$ref": "#/$defs/identifier" },
        "fallback": true,
        "format": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
