{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:typst-bulletin,2026:schema/stackLayoutElement.schema.json",
  "title": "Stack Layout Element",
  "description": "A layout container that arranges items or child elements vertically or horizontally.",
  "type": "object",
  "required": ["id", "type", "name", "x", "y", "width", "height", "margin", "padding", "style", "schema", "data"],
  "properties": {
    "id": { "$ref": "#/$defs/identifier" },
    "type": { "const": "stack" },
    "name": { "type": "string", "minLength": 1 },
    "x": { "$ref": "#/$defs/position" },
    "y": { "$ref": "#/$defs/position" },
    "width": { "$ref": "#/$defs/size" },
    "height": { "$ref": "#/$defs/size" },
    "margin": { "$ref": "#/$defs/spacing" },
    "padding": { "$ref": "#/$defs/spacing" },
    "style": { "$ref": "#/$defs/layoutStyle" },
    "schema": { "type": "array", "items": { "$ref": "#/$defs/dataField" }, "default": [] },
    "data": {
      "type": "object",
      "required": ["direction", "gap", "items"],
      "properties": {
        "direction": { "enum": ["vertical", "horizontal"], "default": "vertical" },
        "gap": { "$ref": "#/$defs/spacing" },
        "items": { "type": "array", "items": { "type": "string" }, "default": [] }
      },
      "additionalProperties": false
    },
    "children": {
      "type": "array",
      "description": "Optional nested visual elements arranged by the stack. Child validation is performed by the matching element schema.",
      "items": { "type": "object" },
      "default": []
    },
    "bindings": {
      "type": "object",
      "properties": {
        "direction": { "$ref": "#/$defs/binding", "x-compatibleFieldTypes": ["choice"] },
        "items": { "$ref": "#/$defs/binding", "x-compatibleFieldTypes": ["list", "text", "richText"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "position": { "oneOf": [{ "type": "number" }, { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%)$" }] },
    "size": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "auto" }, { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%|fr)$" }] },
    "spacing": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%)$" }] },
    "layoutStyle": {
      "type": "object",
      "properties": {
        "font": { "type": "string" },
        "fontSize": { "$ref": "#/$defs/size" },
        "fontWeight": { "enum": ["regular", "medium", "semibold", "bold"] },
        "fontStyle": { "enum": ["normal", "italic"] },
        "color": { "type": "string" },
        "background": { "type": "string" },
        "borderColor": { "type": "string" },
        "borderWidth": { "$ref": "#/$defs/spacing" },
        "align": { "enum": ["left", "center", "right", "justify"] },
        "verticalAlign": { "enum": ["top", "center", "bottom"] }
      },
      "additionalProperties": false
    },
    "dataField": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "richText", "image", "music", "number", "boolean", "date", "choice", "list"] },
        "required": { "type": "boolean", "default": false },
        "defaultValue": true
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["fieldId"],
      "properties": {
        "fieldId": { "$ref": "#/$defs/identifier" },
        "fallback": true,
        "format": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
