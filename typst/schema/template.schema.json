{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:typst-bulletin,2026:schema/template.schema.json",
  "title": "Template",
  "description": "A reusable bulletin template project edited by the GUI builder.",
  "type": "object",
  "required": ["version", "kind", "name", "page", "elements"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "template"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9 _-]+$"
    },
    "description": {
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/page"
    },
    "elements": {
      "type": "array",
      "description": "Elements arranged in template flow order. Items may be predefined elements, custom element instances, or embedded custom element schemas.",
      "items": {
        "$ref": "#/$defs/templateElement"
      },
      "default": []
    },
    "customElements": {
      "type": "array",
      "description": "Optional custom element definitions available to this template without embedding them directly in elements.",
      "items": {
        "$ref": "customElement.schema.json"
      },
      "default": []
    },
    "metadata": {
      "type": "object",
      "description": "Optional app-owned metadata for search, sorting, or future migrations.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "templateElement": {
      "oneOf": [
        { "$ref": "textboxElement.schema.json" },
        { "$ref": "imageElement.schema.json" },
        { "$ref": "gridLayoutElement.schema.json" },
        { "$ref": "stackLayoutElement.schema.json" },
        { "$ref": "canvasElement.schema.json" },
        { "$ref": "dateElement.schema.json" },
        { "$ref": "musicElement.schema.json" },
        { "$ref": "customElement.schema.json" },
        { "$ref": "#/$defs/customElementInstance" }
      ]
    },
    "page": {
      "type": "object",
      "required": ["width", "height", "typstWidth", "typstHeight", "background"],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Canvas width in GUI units."
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Canvas height in GUI units."
        },
        "typstWidth": {
          "$ref": "#/$defs/typstLength"
        },
        "typstHeight": {
          "$ref": "#/$defs/typstLength"
        },
        "background": {
          "type": "string",
          "default": "#fffaf1"
        },
        "margins": {
          "type": "object",
          "properties": {
            "inner": { "$ref": "#/$defs/size" },
            "outer": { "$ref": "#/$defs/size" },
            "top": { "$ref": "#/$defs/size" },
            "bottom": { "$ref": "#/$defs/size" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "customElementInstance": {
      "type": "object",
      "description": "An ordered instance of a reusable custom element definition.",
      "required": ["id", "type", "elementSchemaId", "name", "width", "height", "margin", "padding", "data"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "custom"
        },
        "elementSchemaId": {
          "$ref": "#/$defs/identifier",
          "description": "The id of the custom element schema this instance uses."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "$ref": "#/$defs/size"
        },
        "height": {
          "$ref": "#/$defs/size"
        },
        "margin": {
          "$ref": "#/$defs/spacing"
        },
        "padding": {
          "$ref": "#/$defs/spacing"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "schema": {
          "type": "array",
          "description": "Optional snapshot of the custom element's field schema at insertion time.",
          "items": { "$ref": "#/$defs/dataField" },
          "default": []
        },
        "data": {
          "type": "object",
          "description": "Values keyed by the custom element schema's dataFields[].id.",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "dataField": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "richText", "image", "music", "number", "boolean", "date", "choice", "list"] },
        "required": { "type": "boolean", "default": false },
        "defaultValue": true
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "font": { "type": "string" },
        "fontSize": { "$ref": "#/$defs/size" },
        "fontWeight": { "enum": ["regular", "medium", "semibold", "bold"] },
        "fontStyle": { "enum": ["normal", "italic"] },
        "color": { "type": "string" },
        "background": { "type": "string" },
        "borderColor": { "type": "string" },
        "borderWidth": { "$ref": "#/$defs/spacing" },
        "align": { "enum": ["left", "center", "right", "justify"] },
        "verticalAlign": { "enum": ["top", "center", "bottom"] }
      },
      "additionalProperties": false
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "typstLength": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%)$"
    },
    "size": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "const": "auto" },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%|fr)$" }
      ]
    },
    "spacing": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%)$" }
      ]
    }
  }
}
