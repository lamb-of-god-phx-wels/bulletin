{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:typst-bulletin,2026:schema/textboxElement.schema.json",
  "title": "Textbox Element",
  "description": "A styled text element that can be placed in a template, bulletin, or custom element schema.",
  "type": "object",
  "required": ["id", "type", "name", "x", "y", "width", "height", "margin", "padding", "style", "schema", "data"],
  "properties": {
    "id": { "$ref": "#/$defs/identifier" },
    "type": { "const": "text" },
    "name": { "type": "string", "minLength": 1 },
    "x": { "$ref": "#/$defs/position" },
    "y": { "$ref": "#/$defs/position" },
    "width": { "$ref": "#/$defs/size" },
    "height": { "$ref": "#/$defs/size" },
    "margin": { "$ref": "#/$defs/spacing" },
    "padding": { "$ref": "#/$defs/spacing" },
    "style": { "$ref": "#/$defs/textStyle" },
    "schema": {
      "type": "array",
      "description": "Optional data fields exposed by this predefined element when used as a template placeholder.",
      "items": { "$ref": "#/$defs/dataField" },
      "default": []
    },
    "data": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "default": "Text element" }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "description": "Optional custom-element bindings keyed by textbox data property.",
      "properties": {
        "text": {
          "$ref": "#/$defs/binding",
          "x-compatibleFieldTypes": ["text", "richText", "number", "date", "choice"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "position": {
      "oneOf": [
        { "type": "number" },
        { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%)$" }
      ]
    },
    "size": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "const": "auto" },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%|fr)$" }
      ]
    },
    "spacing": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(pt|in|cm|mm|em|%)$" }
      ]
    },
    "textStyle": {
      "type": "object",
      "properties": {
        "font": { "type": "string", "default": "Calibri" },
        "fontSize": { "$ref": "#/$defs/size" },
        "fontWeight": { "enum": ["regular", "medium", "semibold", "bold"] },
        "fontStyle": { "enum": ["normal", "italic"] },
        "color": { "type": "string", "default": "#251d18" },
        "background": { "type": "string", "default": "#ffffff" },
        "borderColor": { "type": "string", "default": "#d8cdbd" },
        "borderWidth": { "$ref": "#/$defs/spacing" },
        "align": { "enum": ["left", "center", "right", "justify"] },
        "verticalAlign": { "enum": ["top", "center", "bottom"] }
      },
      "additionalProperties": false
    },
    "dataField": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "richText", "image", "music", "number", "boolean", "date", "choice", "list"] },
        "required": { "type": "boolean", "default": false },
        "defaultValue": true
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["fieldId"],
      "properties": {
        "fieldId": { "$ref": "#/$defs/identifier" },
        "fallback": true,
        "format": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
